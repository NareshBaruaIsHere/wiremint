{
  "name": "wiremint",
  "version": "0.1.0",
  "description": "TypeScript-first API mocking and network simulation toolkit. Build without waiting for your backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wiremint": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mock",
    "api",
    "http",
    "testing",
    "server",
    "simulation",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/NareshBaruaIsHere/wiremint",
  "repository": {
    "type": "git",
    "url": "https://github.com/NareshBaruaIsHere/wiremint.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "commander": "^15.0.0",
    "ora": "^10.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^5.1.0"
  }
}
